# Fichiers de configuration PHP jamais servis
<FilesMatch "^(\.user\.ini|php\.ini)$">
  Require all denied
</FilesMatch>

# Hébergement o2switch (cPanel, Apache) : mêmes règles que vercel.json

RewriteEngine On

# Restes de WordPress : 410 (supprimé définitivement) pour que Google les oublie vite
RewriteRule ^(wp-content|wp-includes|wp-admin|wp-json|category|tag|author|comments)(/|$) - [G,L]
RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-signup)\.php$ - [G,L]
RewriteRule (^|/)feed/?$ - [G,L]

# Anciennes adresses courantes
RewriteRule ^(index\.php|home/?|accueil/?)$ https://cashmatic-france.fr/ [R=301,L]
RewriteRule ^politique-de-confidentialite/?$ https://cashmatic-france.fr/mentions-legales.html#donnees [R=301,L,NE]

# /index.html demandé directement -> / (évite le doublon de la page d'accueil)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ https://cashmatic-france.fr/ [R=301,L]

# Anciennes URL WordPress -> nouvelles pages (301, une seule redirection)
RewriteRule ^conditions-generales/?$ https://cashmatic-france.fr/mentions-legales.html [R=301,L,NE]
RewriteRule ^mentions-legales/?$ https://cashmatic-france.fr/mentions-legales.html [R=301,L,NE]
RewriteRule ^politique-de-cookies-ue/?$ https://cashmatic-france.fr/mentions-legales.html#cookies [R=301,L,NE]
RewriteRule ^contact/?$ https://cashmatic-france.fr/#contact [R=301,L,NE]
RewriteRule ^financement/?$ https://cashmatic-france.fr/#financement [R=301,L,NE]
RewriteRule ^lentreprise/?$ https://cashmatic-france.fr/ [R=301,L,NE]
RewriteRule ^nos-realisations/?$ https://cashmatic-france.fr/realisations.html [R=301,L]
RewriteRule ^la-gamme-cashmatic-france/?$ https://cashmatic-france.fr/#gamme [R=301,L,NE]
RewriteRule ^la-gamme-cashmatic-france/gdo-2/?$ https://cashmatic-france.fr/inpay.html [R=301,L,NE]
RewriteRule ^la-gamme-cashmatic-france/selfpay-family-2/?$ https://cashmatic-france.fr/selfpay.html [R=301,L,NE]
RewriteRule ^la-gamme-cashmatic-france/visualpay/?$ https://cashmatic-france.fr/visualpay.html [R=301,L,NE]
RewriteRule ^politique-de-cookies-eu/?$ https://cashmatic-france.fr/mentions-legales.html#cookies [R=301,L,NE]
RewriteRule ^(a-propos|qui-sommes-nous)/?$ https://cashmatic-france.fr/ [R=301,L,NE]
RewriteRule ^(la-gamme-cashmatic-france/)?selfpay-family(-2)?/?$ https://cashmatic-france.fr/selfpay.html [R=301,L,NE]
RewriteRule ^visualpay/?$ https://cashmatic-france.fr/visualpay.html [R=301,L,NE]
RewriteRule ^(la-gamme-cashmatic-france/)?gdo(-2)?/?$ https://cashmatic-france.fr/#gamme [R=301,L,NE]
RewriteRule ^(sitemap_index|page-sitemap|wp-sitemap)\.xml$ https://cashmatic-france.fr/sitemap.xml [R=301,L,NE]

# HTTPS et domaine sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://cashmatic-france.fr%{REQUEST_URI} [L,R=301]

# Dossiers internes non publiés
RewriteRule ^(outils|apercu)(/|$) - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Navigateurs : toujours en https pendant 1 an (ignoré sur une réponse http, donc sans risque)
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(css|js|webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

ErrorDocument 404 /index.html
