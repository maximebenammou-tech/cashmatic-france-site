# ---- Lightspeed K-Series ----
# trial | prod
LSK_ENV=trial
LSK_CLIENT_ID=
LSK_CLIENT_SECRET=
# Doit être en https et enregistrée sur le client OAuth (ex. https://connecteur.exemple.fr/oauth/callback)
LSK_REDIRECT_URI=
LSK_SCOPES=orders-api financial-api offline_access
# Identifiant de l'établissement (GET /o/op/data/businesses)
LSK_BUSINESS_LOCATION_ID=
# Code du moyen de paiement créé dans le back-office Lightspeed pour les encaissements Cashmatic
LSK_PAYMENT_METHOD=CASHMATIC
# Webhook Order and Pay : identifiant (sensible à la casse) et URL publique vers ce connecteur
LSK_WEBHOOK_ENDPOINT_ID=CASHMATIC
LSK_WEBHOOK_URL=https://connecteur.exemple.fr/webhooks/lightspeed
LSK_WEBHOOK_USER=
LSK_WEBHOOK_PASSWORD=
# Facultatif : employé et caisse qui reçoivent le paiement
LSK_STAFF_ID=
LSK_DEVICE_ID=
# Délai max de livraison du paiement à la caisse (minimum 60000 ms)
LSK_TASK_TTL_MS=60000

# ---- Cashmatic (API locale de la machine) ----
CASHMATIC_URL=https://192.168.1.50:50301
CASHMATIC_USERNAME=
CASHMATIC_PASSWORD=
# La machine utilise un certificat auto-signé : true pour ne pas le vérifier
CASHMATIC_TLS_INSECURE=true
# Temps laissé au client pour insérer l'argent (secondes)
CASHMATIC_PAYMENT_TIMEOUT_S=120
CASHMATIC_POLL_MS=300

# ---- Connecteur ----
PORT=8080
DATA_DIR=./data
# Attente de la confirmation Lightspeed (webhook) avant réconciliation
WEBHOOK_WAIT_MS=90000
